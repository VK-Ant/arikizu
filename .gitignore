# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.uv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
pnpm-debug.log*

# UI build output
/ui/.svelte-kit
/ui/build

# Models directory: ignore by default, but keep the small default
# models that ship with the demo so a fresh git clone works out of
# the box. Larger models (SmolLM2 GGUF, Whisper, etc.) are still
# pulled on first run by scripts/download-default-models.sh.
/models/*
!/models/.gitkeep
!/models/NOTICE.md
!/models/yolov8n.onnx
!/models/silero_vad.onnx
!/models/*.onnx.json

/golden/*
!/golden/.gitkeep

# Local sockets, logs, caches
/tmp/
*.log
*.sock

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*~

# dist artifacts
/dist/
