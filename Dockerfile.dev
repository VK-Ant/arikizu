# Arikizu development container.
#
# Purpose:  one-command cross-OS dev environment. Mac, Windows, or Linux hosts
#           run the same containerized toolchain.
# NOT for:  production Pi install. Docker daemon alone eats ~150 MB RAM; the
#           Pi image (Tier 3) ships as a native systemd service instead.
#
# Build:   docker build -f Dockerfile.dev -t arikizu-dev .
# Run:     docker run -it --rm --net=host -v $(pwd):/work arikizu-dev
# Or:      scripts/docker-dev.sh    (wrapper that mounts cwd and preserves target cache)
#
# Inside the container: make build / make run / make smoke all work.
# The HTTP server inside the container binds to 127.0.0.1:7000 which `--net=host`
# makes reachable from your Mac/Windows browser.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"

# ---------------------------------------------------------------------------
# System toolchains
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    ca-certificates \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    unzip \
    xz-utils \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Rust (stable; the project pins via rust-toolchain.toml)
# ---------------------------------------------------------------------------
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile minimal \
    && rustup component add rustfmt clippy

# ---------------------------------------------------------------------------
# Python + uv (via astral.sh/uv)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    /root/.local/bin/uv python install 3.11

# ---------------------------------------------------------------------------
# Node + pnpm (for the UI; only used if you touch the dashboard)
# ---------------------------------------------------------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g pnpm@9 && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ONNX Runtime (CPU) and sklearn stack — so `make smoke` has real backends
# ---------------------------------------------------------------------------
RUN /root/.local/bin/uv pip install --python python3 --system \
    onnxruntime scikit-learn joblib numpy

WORKDIR /work

CMD ["bash"]
